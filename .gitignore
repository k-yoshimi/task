# External dependencies cloned at the repo root by scripts/setup.sh.
# bpsd is sibling-cloned to ../bpsd by setup.sh, so the in-repo path
# only matters if a user manually clones it inside the worktree.
# gsaf is also an external dependency (https://github.com/ats-fukuyama/gsaf)
# that may be cloned in-tree during local development.
/bpsd/
/gsaf/

# Downstream task-web worktrees (created under .worktrees/ by task-web dev flow)
.worktrees/

# Per-machine Claude Code workspace state.
# .claude/commands/ and .claude/hooks/ ARE tracked — they are project
# workflow assets that benefit all collaborators. Settings and worktree
# storage are per-machine and excluded here so a fresh clone doesn't
# accidentally commit hook registrations or per-machine permissions.
.claude/worktrees/
.claude/settings.local.json
