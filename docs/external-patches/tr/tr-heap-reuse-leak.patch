+    QRHO(:) = 0.D0
+    RTM(:) = 0.D0; AMZ(:) = 0.D0; PEXT(:) = 0.D0
+    PEX(:,:) = 0.D0; SEX(:,:) = 0.D0
+    AKDWD(:,:,:) = 0.D0; AKDWP(:,:,:) = 0.D0
+    ADDWD(:,:,:) = 0.D0; ADDWP(:,:,:) = 0.D0
+    VV(:,:,:,:) = 0.D0; DD(:,:,:,:) = 0.D0
+    VI(:,:,:,:) = 0.D0; DI(:,:,:,:) = 0.D0
+    AJBSNC(:) = 0.D0; ETANC(:) = 0.D0; AJEXNC(:) = 0.D0
