+    AKLP(:,:,:) = 0.D0; AKLD(:,:,:) = 0.D0
+    ADLP(:,:,:) = 0.D0; ADLD(:,:,:) = 0.D0
+    RGFLS(:,:,:) = 0.D0; RQFLS(:,:,:) = 0.D0
